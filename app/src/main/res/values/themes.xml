<resources>
    <!-- Modern Material 3 Theme -->
    <style name="Theme.CashPilot" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy_primary</item>
        <item name="android:statusBarColor">@color/navy_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CashPilot</item>
    </style>
</resources>
